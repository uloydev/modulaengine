# ModulaEngine Server Configuration
PORT=8080
ENV=development
LOG_LEVEL=info

# Database Connection Pools
DATABASE_URL=postgres://modula_runtime:secret@localhost:5432/modulaengine?sslmode=disable
DATABASE_CONTROL_URL=postgres://modula_control:control_secret@localhost:5432/modulaengine?sslmode=disable
DATABASE_READ_URL=

# Security & Secrets
MODULA_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super-secret-jwt-signing-key-change-in-production

# Operational Modes
HEADLESS=false
